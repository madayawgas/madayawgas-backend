# ==========================================
# Deployment & Environment Mode
# ==========================================
# Set PRODUCTION=true to target the remote Supabase PostgreSQL database with SSL.
# Set PRODUCTION=false (default) for local PostgreSQL development and testing.
PRODUCTION=false

# ==========================================
# Database Connection Strings
# ==========================================
# Production database (e.g. Supabase connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Local / Test database
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/madayawgas"

# Database Connection Pool (optional: defaults to 20 in production, 50 in development)
# DB_POOL_MAX=20

# Explicit SSL override (optional: defaults to true for Supabase/production, false for localhost)
# DATABASE_SSL=true

# ==========================================
# Server & CORS Configuration
# ==========================================
PORT=5000
CORS_ORIGIN=https://madayawgas.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:5174

# Public Base URL (optional: auto-detected on Render via RENDER_EXTERNAL_URL, or defaults to http://localhost:PORT)
# BASE_URL=https://madayawgas-backend.onrender.com