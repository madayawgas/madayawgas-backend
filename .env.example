# ==========================================
# Deployment & Environment Mode
# ==========================================
PRODUCTION=false

# ==========================================
# Database Connection Strings
# ==========================================
# Production database (e.g. Supabase connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Local / Test database
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/madayawgas"


# ==========================================
# Server & CORS Configuration
# ==========================================
PORT=5000
CORS_ORIGIN=https://madayawgas.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:5174


# ==========================================
# Media Storage Subsystem
# ==========================================
# Local storage destination (used when PRODUCTION=false, defaults to ./uploads)
LOCAL_MEDIA_PATH="./uploads"

# Supabase Storage configuration (used when PRODUCTION=true)
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# SUPABASE_MEDIA_BUCKET="madayawgas-media"