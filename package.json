{
  "name": "madayawgas-backend",
  "version": "1.0.0",
  "description": "MadayawGas Backend API",
  "main": "src/server.js",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "start": "npm run db:migrate && node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test src/test/*.test.js",
    "db:setup": "node database/scripts/setup.js",
    "db:migrate": "node database/scripts/migrate.js",
    "db:seed": "node database/scripts/seed.js",
    "db:export": "node database/scripts/export-schema.js",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "postgresql",
    "inventory",
    "madayawgas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "nodemon": "^3.1.14"
  }
}
